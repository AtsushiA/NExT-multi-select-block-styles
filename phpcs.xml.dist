<?xml version="1.0"?>
<ruleset name="NExT Multi Select Block Styles">
    <description>Custom ruleset for NExT Multi Select Block Styles</description>

    <!-- 対象ファイル -->
    <file>./next-multi-select-block-styles.php</file>

    <!-- 除外 -->
    <exclude-pattern>./vendor/*</exclude-pattern>
    <exclude-pattern>./node_modules/*</exclude-pattern>
    <exclude-pattern>./tests/*</exclude-pattern>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- プラグインメインファイルはスラッグ名のためクラス名ベースのファイル名規則を除外 -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <!-- PHP互換性チェック -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- PHP バージョン -->
    <config name="testVersion" value="8.3-"/>

    <!-- テキストドメイン -->
    <config name="text_domain" value="next-multi-select-block-styles"/>

    <!-- プレフィックス -->
    <config name="prefixes" value="multi_select_block_styles,Multi_Select_Block_Styles"/>
    <config name="minimum_wp_version" value="6.5"/>
</ruleset>
